<Window
    x:Class="PasswordManager.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PasswordManager.Desktop.Models"
    Title="Password Manager">

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}">
        <NavigationView
            x:Name="NavView"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            OpenPaneLength="220"
            CompactPaneLength="52"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="All Items" Tag="All" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Favorites" Tag="Favorites">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE734;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="Logins" Tag="Logins">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Servers" Tag="Servers">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEDA2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Secure Notes" Tag="Notes">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE70B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Main Content Area: Master - Detail Layout -->
            <Grid Margin="16,12,16,16" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Header: Search and Theme Action Bar -->
                <Grid Grid.Row="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        PlaceholderText="Search vault items (Title, username, domain, notes)..."
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button
                            Content="Theme Toggle"
                            Click="ThemeButton_Click"
                            ToolTipService.ToolTip="Toggle Light / Dark mode" />
                    </StackPanel>
                </Grid>

                <!-- Master-Detail Content Split -->
                <Grid Grid.Row="1" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" MinWidth="260" MaxWidth="440" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Items List Pane -->
                    <Border
                        Grid.Column="0"
                        Background="{ThemeResource ListPaneBackgroundBrush}"
                        BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid RowSpacing="8" Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Margin="8,4,8,4"
                                Text="Vault Items"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextSecondaryBrush}" />

                            <ListView
                                Grid.Row="1"
                                ItemsSource="{x:Bind ViewModel.FilteredItems, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:SyntheticVaultItem">
                                        <Grid Padding="4,8" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Category Icon -->
                                            <Border
                                                Grid.Column="0"
                                                Width="36"
                                                Height="36"
                                                CornerRadius="6"
                                                Background="{ThemeResource BadgeBackgroundBrush}">
                                                <FontIcon
                                                    Glyph="{x:Bind CategoryGlyph}"
                                                    FontSize="16"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextPrimaryBrush}" />
                                            </Border>

                                            <!-- Title & Username -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock
                                                    Text="{x:Bind Title}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource TextPrimaryBrush}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Text="{x:Bind Username}"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextSecondaryBrush}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- Favorite Star Indicator -->
                                            <FontIcon
                                                Grid.Column="2"
                                                Glyph="&#xE735;"
                                                FontSize="14"
                                                Foreground="#FFFFC83B"
                                                Opacity="{x:Bind FavoriteOpacity}"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Right: Item Detail Pane -->
                    <Border
                        Grid.Column="1"
                        Background="{ThemeResource DetailPaneBackgroundBrush}"
                        BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24">

                        <Grid RowSpacing="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Header: Title, Category & Favorite Toggle -->
                            <Grid Grid.Row="0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.SelectedItemTitle, Mode=OneWay}"
                                        FontSize="24"
                                        FontWeight="Bold"
                                        Foreground="{ThemeResource TextPrimaryBrush}" />
                                    <Border
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource BadgeBackgroundBrush}"
                                        Padding="8,2"
                                        CornerRadius="4">
                                        <TextBlock
                                            Text="{x:Bind ViewModel.SelectedItemCategory, Mode=OneWay}"
                                            FontSize="12"
                                            Foreground="{ThemeResource BadgeTextBrush}" />
                                    </Border>
                                </StackPanel>

                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Top"
                                    Click="FavoriteButton_Click"
                                    ToolTipService.ToolTip="Toggle Favorite">
                                    <FontIcon Glyph="&#xE734;" />
                                </Button>
                            </Grid>

                            <!-- Username Field Card -->
                            <Border
                                Grid.Row="1"
                                Background="{ThemeResource CardBackgroundBrush}"
                                BorderBrush="{ThemeResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16,12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Username / Account" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.SelectedItemUsername, Mode=OneWay}"
                                            FontWeight="SemiBold"
                                            IsTextSelectionEnabled="True"
                                            Foreground="{ThemeResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Content="Copy"
                                        VerticalAlignment="Center"
                                        Click="CopyUsername_Click" />
                                </Grid>
                            </Border>

                            <!-- Password Field Card -->
                            <Border
                                Grid.Row="2"
                                Background="{ThemeResource CardBackgroundBrush}"
                                BorderBrush="{ThemeResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16,12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Password" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.DisplayedPassword, Mode=OneWay}"
                                            FontFamily="Consolas"
                                            FontWeight="SemiBold"
                                            IsTextSelectionEnabled="True"
                                            Foreground="{ThemeResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Content="{x:Bind ViewModel.RevealButtonLabel, Mode=OneWay}"
                                        VerticalAlignment="Center"
                                        Command="{x:Bind ViewModel.TogglePasswordRevealCommand}" />
                                    <Button
                                        Grid.Column="2"
                                        Content="Copy"
                                        VerticalAlignment="Center"
                                        Click="CopyPassword_Click" />
                                </Grid>
                            </Border>

                            <!-- Website / Domain Field Card -->
                            <Border
                                Grid.Row="3"
                                Background="{ThemeResource CardBackgroundBrush}"
                                BorderBrush="{ThemeResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16,12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Website / Domain" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.SelectedItemWebsiteUrl, Mode=OneWay}"
                                        Foreground="{ThemeResource AccentBrandBrush}"
                                        IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </Border>

                            <!-- Notes Card -->
                            <Border
                                Grid.Row="4"
                                Background="{ThemeResource CardBackgroundBrush}"
                                BorderBrush="{ThemeResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16,12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Notes" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.SelectedItemNotes, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource TextPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Status Bar Footer -->
                <Border
                    Grid.Row="2"
                    Background="{ThemeResource CardBackgroundBrush}"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,6">
                    <Grid>
                        <TextBlock
                            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            Text="Local Shell v1.0 • M0 Foundation"
                            FontSize="11"
                            Foreground="{ThemeResource TextSecondaryBrush}" />
                    </Grid>
                </Border>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
