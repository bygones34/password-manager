<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dimensions & Spacing Tokens -->
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="DetailPanePadding">24</Thickness>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">6</CornerRadius>

    <!-- Semantic Theme Brushes -->
    <ResourceDictionary.ThemeDictionaries>
        <!-- Light Theme -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFF3F3F3" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#FFE5E5E5" />
            <SolidColorBrush x:Key="ListPaneBackgroundBrush" Color="#FFF9F9F9" />
            <SolidColorBrush x:Key="DetailPaneBackgroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1C1C1C" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF5C5C5C" />
            <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#FFEAEAEA" />
            <SolidColorBrush x:Key="BadgeTextBrush" Color="#FF333333" />
            <SolidColorBrush x:Key="AccentBrandBrush" Color="#FF0067C0" />
        </ResourceDictionary>

        <!-- Dark Theme -->
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF202020" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FF2D2D2D" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#FF3D3D3D" />
            <SolidColorBrush x:Key="ListPaneBackgroundBrush" Color="#FF262626" />
            <SolidColorBrush x:Key="DetailPaneBackgroundBrush" Color="#FF202020" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFA0A0A0" />
            <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#FF383838" />
            <SolidColorBrush x:Key="BadgeTextBrush" Color="#FFCCCCCC" />
            <SolidColorBrush x:Key="AccentBrandBrush" Color="#FF4CC2FF" />
        </ResourceDictionary>

        <!-- High Contrast / Fallback -->
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF202020" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FF2D2D2D" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#FF3D3D3D" />
            <SolidColorBrush x:Key="ListPaneBackgroundBrush" Color="#FF262626" />
            <SolidColorBrush x:Key="DetailPaneBackgroundBrush" Color="#FF202020" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFA0A0A0" />
            <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#FF383838" />
            <SolidColorBrush x:Key="BadgeTextBrush" Color="#FFCCCCCC" />
            <SolidColorBrush x:Key="AccentBrandBrush" Color="#FF4CC2FF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
